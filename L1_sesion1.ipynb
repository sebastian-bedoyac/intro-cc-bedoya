      "source": [
        "La caja que sigue dibuja lo mismo como imagen, con la cuadrícula numerada. Les va a servir para ubicar filas y columnas en el paso 5."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "937f8301",
      "metadata": {
        "id": "937f8301"
      },
      "outputs": [],
      "source": [
        "# CAJA: dibujo con cuadrícula numerada, para encontrar filas y columnas.\n",
        "# dibujar_imagen(bits, columnas) -> None   Muestra los bits como imagen: 1 = negro, 0 = blanco.\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def dibujar_imagen(bits, columnas, alto=12):\n",
        "    filas = len(bits) // columnas\n",
        "    matriz = [[int(bits[f * columnas + c]) for c in range(columnas)] for f in range(filas)]\n",
        "    fig, ax = plt.subplots(figsize=(alto * columnas / max(filas, 1) + 1, alto))\n",
        "    ax.imshow(matriz, cmap=\"Greys\", interpolation=\"nearest\")\n",
        "    ax.set_xticks(range(0, columnas, 5)); ax.set_yticks(range(0, filas, 5))\n",
        "    ax.set_xticks([x - 0.5 for x in range(columnas + 1)], minor=True)\n",
        "    ax.set_yticks([y - 0.5 for y in range(filas + 1)], minor=True)\n",
        "    ax.grid(which=\"minor\", color=\"#dddddd\", linewidth=0.4)\n",
        "    ax.set_xlabel(\"columna\"); ax.set_ylabel(\"fila\")\n",
        "    ax.set_title(f\"{filas} filas x {columnas} columnas\")\n",
        "    plt.show()"
      ]
    },
