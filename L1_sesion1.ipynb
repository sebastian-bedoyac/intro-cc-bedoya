      "source": [
        "bits = cargar_mensaje()\n",
        "unos, sha = huella(bits)\n",
        "print(\"Unos:\", unos)\n",
        "print(\"Huella SHA-256:\", sha)\n",
        "print(\"Comparen estas dos cifras con las del README de introduccion_cc en el repositorio de laboratorios.\")"
      ]
